# ---------------------------------------------------------------------------
# OPEX Hub — environment variables
# Copy this file to `.env.local` and fill in your own values. Never commit it.
# ---------------------------------------------------------------------------

# Google Apps Script Web App deployment URL.
# Deploy > New deployment > Web app > copy the /exec URL here.
# Example: https://script.google.com/macros/s/XXXXXXXXXXXX/exec
VITE_API_URL=

# Optional shared API key. Must match the API_KEY value stored in the Apps
# Script project's Script Properties (see apps-script/Code.gs -> setApiKey()).
VITE_API_KEY=

# NOTE: These values are embedded in the client bundle. The API key is a
# lightweight shared secret, not a substitute for real authentication. For
# production use Google OAuth / Workspace SSO and restrict the web app.
